{
  "name": "pulsesync-example-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PulseSync React addon template built with the official SDK",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "format": "oxfmt .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "yarn build && yarn sync"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@pulsesync/addon-sdk": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.75.0",
    "react": "19.3.1",
    "sass": "^1.107.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-sass-dts": "^1.3.39"
  }
}
